# Порт HTTP сервера (по умолчанию 3001). Если «EADDRINUSE» — порт занят: остановите старый node
# или задайте другой: PORT=3002 (и в dev выставьте VITE_DEV_API_PROXY=http://127.0.0.1:3002).
# ── Supabase (Postgres) ─────────────────────────────────────────────────────
# Project: metaluck — https://supabase.com/dashboard/project/aqporgtdiwckcfxzndrb
SUPABASE_URL=https://aqporgtdiwckcfxzndrb.supabase.co
# Settings → API → service_role (secret). NEVER expose in the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Frontend on Vercel ──────────────────────────────────────────────────────
# After API is hosted, set this at build time on Vercel (client env):
# VITE_API_BASE_URL=https://your-api-host.example.com

# Пусто = запросы идут на тот же origin, что и страница (/api/...) — так и нужно для туннеля,
# если один домен отдаёт и статику, и API (Fastify или nginx см. nginx.api-spa.example.conf).
# Только если API на ДРУГОМ домене, укажите полный origin без слэша в конце:
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_BASE_URL=
#
# Только dev: куда проксировать /api (см. client/vite.config.ts). По умолчанию 127.0.0.1:3001
# VITE_DEV_API_PROXY=http://127.0.0.1:3001

# Явный список Origin для CORS (через запятую). Пусто = как раньше (любой origin, удобно для Telegram).
# CORS_ORIGIN=https://web.telegram.org,https://your-domain.com

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_MINI_APP_PATH=app
TELEGRAM_WEBHOOK_SECRET_TOKEN=generate_random_secret_here
# Chat id for withdraw alerts (your personal Telegram id or group):
# TELEGRAM_ADMIN_CHAT_ID=
# Telegram user ids with Payment Hub admin UI access (comma-separated). Also seed via admin UI table.
# TELEGRAM_ADMIN_IDS=123456789
# Secret for POST /api/admin/broadcast and admin Payment Hub (header x-admin-secret).
# ADMIN_API_SECRET=generate_long_random_secret
PRE_CHECKOUT_DEADLINE_MS=9000
# Optional webhook URL helper for scripts:
# TELEGRAM_WEBHOOK_URL=https://your-host.trycloudflare.com/api/telegram/webhook
# Optional invoice image for createInvoiceLink:
# STARS_INVOICE_PHOTO_URL=https://example.com/stars-pack.png

# ── Crypto deposits (TON / USDT on TON) ──────────────────────────────────────
# Treasury address that receives user deposits (required to enable crypto rails):
# TON_DEPOSIT_ADDRESS=EQ...
# Optional TonAPI key (https://tonapi.io) — higher rate limits:
# TONAPI_KEY=
# TON_API_BASE=https://tonapi.io
# Official USDT jetton master (mainnet default is fine):
# USDT_TON_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# TON_DEPOSIT_CONFIRMATIONS=1
# TON_DEPOSIT_TTL_MS=3600000
# DEPOSIT_MIN_TON_NANOTONS=100000000
# DEPOSIT_MIN_USDT_MICROS=1000000

# ── Exchange / Market Rates ───────────────────────────────────────────────────
# Redis cache for Market Rates Service (required in prod):
# REDIS_URL=redis://default:password@host:6379
# REDIS_KEY_PREFIX=metaluck:rates
# Auto-refresh interval (TON/USD, USDT/USD, Stars/USD):
# RATES_REFRESH_MS=60000
# CoinGecko (used ONLY inside Market Rates oracle — do not call from other modules):
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Stars/USD: optional JSON oracle `{ "usd": 0.015 }`, else STARS_USD config:
# STARS_USD_ORACLE_URL=
# STARS_USD=0.015
# EXCHANGE_QUOTE_TTL_MS=30000
# Optional source env path for data import from frog-case backend:
# FROG_SOURCE_ENV_PATH=../Telegram mini gemes/frog-case-backend/.env
